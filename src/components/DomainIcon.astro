---
/**
 * Icons for what a Little Dipper holds, in Little Dipper's own icon style: hand-drawn and two-tone, a soft fill
 * (--icon-fill) under a currentColor outline, with the odd little star.
 */
interface Props { name: string; size?: number }
const { name, size = 30 } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'identity' && <>
    <rect x="2.5" y="5" width="19" height="14" rx="2.5" fill="var(--icon-fill)" />
    <circle cx="8.5" cy="11" r="2.2" />
    <path d="M5.3 16.2c.6-1.6 1.8-2.4 3.2-2.4s2.6.8 3.2 2.4" />
    <path d="M14 10h4.5M14 13h3" />
  </>}
  {name === 'journey' && <>
    <path d="M12 21s6-5.6 6-10.5a6 6 0 0 0-12 0C6 15.4 12 21 12 21z" fill="var(--icon-fill)" />
    <circle cx="12" cy="10.5" r="2.2" />
    <path d="M3 21h4M17 21h4" stroke-dasharray="1.5 2" />
  </>}
  {name === 'health' && <>
    <path d="M12 20s-7.5-4.4-7.5-10A4.3 4.3 0 0 1 12 7.4 4.3 4.3 0 0 1 19.5 10c0 5.6-7.5 10-7.5 10z" fill="var(--icon-fill)" />
    <path d="M6.5 12.5h3l1.3-2.5 2 4.5 1.4-2h3.3" />
  </>}
  {name === 'money' && <>
    <rect x="3" y="7" width="18" height="12" rx="2.5" fill="var(--icon-fill)" />
    <path d="M16 13h3M6 7l9-3 1.2 3" />
    <circle cx="16.3" cy="13" r=".6" fill="currentColor" />
  </>}
  {name === 'belongings' && <>
    <path d="M3.5 11 12 4l8.5 7v8a1 1 0 0 1-1 1h-15a1 1 0 0 1-1-1z" fill="var(--icon-fill)" />
    <circle cx="10" cy="14.5" r="2" />
    <path d="M12 14.5h4.5M15 14.5v1.8" />
  </>}
  {name === 'people' && <>
    <circle cx="8.5" cy="8" r="3" fill="var(--icon-fill)" />
    <path d="M3 19c.6-3.2 2.8-5 5.5-5s4.9 1.8 5.5 5" fill="var(--icon-fill)" />
    <circle cx="17.5" cy="15.5" r="1.6" />
    <circle cx="15.2" cy="12.6" r=".8" fill="currentColor" /><circle cx="17.5" cy="11.6" r=".8" fill="currentColor" /><circle cx="19.8" cy="12.6" r=".8" fill="currentColor" />
  </>}
  {name === 'documents' && <>
    <path d="M6 3h8l4 4v13a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1z" fill="var(--icon-fill)" />
    <path d="M14 3v4h4M8 11h7M8 14h7M8 17h4" />
  </>}
  {name === 'dates' && <>
    <rect x="3.5" y="5" width="17" height="15" rx="2.5" fill="var(--icon-fill)" />
    <path d="M3.5 9.5h17M8 3v4M16 3v4" />
    <path d="M12 12.3l.8 1.7 1.8.3-1.3 1.3.3 1.8-1.6-.9-1.6.9.3-1.8-1.3-1.3 1.8-.3z" fill="currentColor" stroke="none" />
  </>}
  {name === 'cloud' && <>
    <path d="M7 18.5a4.5 4.5 0 0 1-.6-9 5.5 5.5 0 0 1 10.6-1.2A4.6 4.6 0 0 1 17 18.5z" fill="var(--icon-fill)" />
    <path d="m12 10.6.7 1.5 1.6.2-1.2 1.1.3 1.6-1.4-.8-1.4.8.3-1.6-1.2-1.1 1.6-.2z" fill="currentColor" stroke="none" />
  </>}
  {name === 'computer' && <>
    <rect x="3" y="4" width="18" height="12" rx="2" fill="var(--icon-fill)" />
    <path d="M9 20h6M12 16v4" />
    <path d="m12 7.6.7 1.5 1.6.2-1.2 1.1.3 1.6-1.4-.8-1.4.8.3-1.6-1.2-1.1 1.6-.2z" fill="currentColor" stroke="none" />
  </>}
</svg>
