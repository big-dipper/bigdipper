---
// The docs header: Big Dipper's name back to the home page, then "Docs" to the docs' start.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<span class="docs-brand">
  <a href={`${base}/`} class="docs-brand-home">Big Dipper</a>
  <span class="docs-brand-sep" aria-hidden="true">/</span>
  <a href={`${base}/docs/`} class="docs-brand-docs">Docs</a>
</span>

<style>
  .docs-brand { display: inline-flex; align-items: baseline; gap: 0.5rem; white-space: nowrap; }
  .docs-brand a { text-decoration: none; color: var(--sl-color-white); }
  .docs-brand-home { font-family: 'Caprasimo', system-ui, sans-serif; font-size: 1.35rem; }
  .docs-brand-sep { color: var(--sl-color-gray-4); }
  .docs-brand-docs { font-weight: 600; color: var(--sl-color-gray-2) !important; }
</style>
