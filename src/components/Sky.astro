---
/**
 * The home page's night sky, full width behind the opening words: a dense field of stars, the Milky Way, and the
 * two dippers picked out only by a little more light. Polaris, the tip of the Little Dipper's handle, shines as a
 * sparkle, the mark people know for AI: your Little Dipper holds your North Star, for the AI era.
 * Drawn, not photographed; every star comes from a fixed seed, so the sky is the same on every visit.
 */
type P = [number, number];
const bigDipper: P[] = [[820, 575], [902, 512], [978, 482], [1052, 466], [1046, 574], [1150, 604], [1172, 478]];
const merak = bigDipper[5], dubhe = bigDipper[6];
// Polaris sits on the line from Merak through Dubhe, as it does in the real sky.
const px = dubhe[0] + 2.55 * (dubhe[0] - merak[0]), py = dubhe[1] + 2.55 * (dubhe[1] - merak[1]);
const littleDipper: P[] = [[1296, 184], [1352, 214], [1394, 262], [1474, 236], [1500, 304], [1418, 326]];
// How bright each star really is (magnitude: lower is brighter), so the shapes read as sky, not as dots.
// Big Dipper: Alkaid, Mizar, Alioth, Megrez, Phecda, Merak, Dubhe. Little Dipper: Yildun, ε, ζ, Kochab, Pherkad, η.
const bigMag = [1.9, 2.2, 1.8, 3.3, 2.4, 2.4, 1.8];
const littleMag = [4.4, 4.2, 4.3, 2.1, 3.0, 5.0];
const size = (m: number) => 4.3 - 0.55 * m;

let seed = 11;
const rand = () => ((seed = (seed * 16807) % 2147483647) / 2147483647);
const gauss = () => Math.sqrt(-2 * Math.log(rand() + 1e-9)) * Math.cos(2 * Math.PI * rand());
const tints = ['#ffffff', '#ffffff', '#ffffff', '#dfe8ff', '#fff1d6', '#cfe0f5', '#ffe9e0'];
const tint = () => tints[Math.floor(rand() * tints.length)];

// The field: scattered everywhere.
const field = Array.from({ length: 900 }, () => {
  const bright = rand() > 0.96;
  return { x: rand() * 1600, y: rand() * 720, r: bright ? 1.1 + rand() * 0.9 : 0.25 + rand() * 0.6, o: 0.2 + rand() * 0.6, c: tint(), tw: rand() > 0.75, d: (rand() * 8).toFixed(1) };
});
// The Milky Way: a crowd of faint stars along a band, thickest at its middle.
const angle = (-24 * Math.PI) / 180, cos = Math.cos(angle), sin = Math.sin(angle);
const band = Array.from({ length: 1700 }, () => {
  const along = (rand() - 0.5) * 2000, across = gauss() * (55 + 35 * Math.cos((along / 1000) * Math.PI / 2));
  return { x: 800 + along * cos - across * sin, y: 360 + along * sin + across * cos, r: 0.2 + rand() * 0.55, o: 0.15 + rand() * 0.5, c: tint() };
});

/** A four-pointed sparkle with curved sides, the mark people know for AI. */
const sparkle = (cx: number, cy: number, r: number, w = 0.16) =>
  `M${cx} ${cy - r} Q${cx + w * r} ${cy - w * r} ${cx + r} ${cy} Q${cx + w * r} ${cy + w * r} ${cx} ${cy + r} Q${cx - w * r} ${cy + w * r} ${cx - r} ${cy} Q${cx - w * r} ${cy - w * r} ${cx} ${cy - r}Z`;
---
<svg class="sky" viewBox="0 0 1600 720" preserveAspectRatio="xMaxYMid slice" role="img"
  aria-label="A night sky full of stars, with the Milky Way, the Big Dipper and the Little Dipper. Polaris, the North Star, shines at the tip of the Little Dipper's handle.">
  <defs>
    <filter id="soft" x="-50%" y="-50%" width="200%" height="200%"><feGaussianBlur stdDeviation="28" /></filter>
    <filter id="softer" x="-50%" y="-50%" width="200%" height="200%"><feGaussianBlur stdDeviation="10" /></filter>
    <radialGradient id="polaris-glow"><stop offset="0" stop-color="#fff4dc" stop-opacity="0.9" /><stop offset="0.3" stop-color="#ffe2a8" stop-opacity="0.35" /><stop offset="1" stop-color="#ffd27a" stop-opacity="0" /></radialGradient>
    <radialGradient id="sparkle-fill"><stop offset="0" stop-color="#ffffff" /><stop offset="0.5" stop-color="#fff4dc" /><stop offset="1" stop-color="#ffe2a8" stop-opacity="0.6" /></radialGradient>
    <radialGradient id="star-glow"><stop offset="0" stop-color="#ffffff" stop-opacity="0.4" /><stop offset="1" stop-color="#ffffff" stop-opacity="0" /></radialGradient>
    <linearGradient id="fade-left" x1="0" x2="1"><stop offset="0" stop-color="#0d1119" stop-opacity="0.7" /><stop offset="0.45" stop-color="#0d1119" stop-opacity="0.12" /><stop offset="1" stop-color="#0d1119" stop-opacity="0" /></linearGradient>
  </defs>

  <!-- The Milky Way: a wide blue haze, a brighter warm core, and a dark lane of dust through it. -->
  <g transform="rotate(-24 800 360)">
    <ellipse cx="800" cy="360" rx="1000" ry="190" fill="#5f78b0" opacity="0.13" filter="url(#soft)" />
    <ellipse cx="820" cy="355" rx="820" ry="95" fill="#8ea6d8" opacity="0.16" filter="url(#soft)" />
    <ellipse cx="860" cy="350" rx="520" ry="48" fill="#f0dcc0" opacity="0.14" filter="url(#softer)" />
    <ellipse cx="640" cy="372" rx="260" ry="30" fill="#c8b8d8" opacity="0.10" filter="url(#softer)" />
    <ellipse cx="900" cy="368" rx="560" ry="13" fill="#0b0e15" opacity="0.45" filter="url(#softer)" />
  </g>
  <g>{band.map((s) => <circle cx={s.x.toFixed(1)} cy={s.y.toFixed(1)} r={s.r.toFixed(2)} fill={s.c} opacity={s.o.toFixed(2)} />)}</g>
  <g>{field.map((s) => <circle cx={s.x.toFixed(1)} cy={s.y.toFixed(1)} r={s.r.toFixed(2)} fill={s.c} opacity={s.o.toFixed(2)} class={s.tw ? 'tw' : undefined} style={s.tw ? `animation-delay:${s.d}s` : undefined} />)}</g>

  <!-- Readability: the words sit on the darker left. -->
  <rect width="1600" height="720" fill="url(#fade-left)" />

  <!-- The two dippers: no lines, just a little more light than the stars around them. -->
  {bigDipper.map(([x, y], i) => <g class="dipper" style={`animation-delay:${i * 0.5}s`}><circle cx={x} cy={y} r={size(bigMag[i]) * 3} fill="url(#star-glow)" /><circle cx={x} cy={y} r={size(bigMag[i])} fill="#f4f6ff" /></g>)}
  {littleDipper.map(([x, y], i) => <g class="dipper" style={`animation-delay:${i * 0.6 + 0.3}s`}><circle cx={x} cy={y} r={size(littleMag[i]) * 3} fill="url(#star-glow)" /><circle cx={x} cy={y} r={size(littleMag[i])} fill="#fff4dc" /></g>)}

  <!-- Polaris, as a sparkle, with a little one beside it. -->
  <g class="polaris">
    <circle cx={px} cy={py} r="66" fill="url(#polaris-glow)" class="breathe" />
    <path d={sparkle(px, py, 30)} fill="url(#sparkle-fill)" class="shine" />
    <path d={sparkle(px + 30, py - 28, 9)} fill="#fff4dc" class="shine small" />
    <circle cx={px} cy={py} r="3.5" fill="#ffffff" />
  </g>
</svg>

<style>
  .tw { animation: twinkle 7s ease-in-out infinite; }
  .dipper { animation: glint 6s ease-in-out infinite; }
  .breathe { animation: breathe 5s ease-in-out infinite; transform-box: fill-box; transform-origin: center; }
  .shine { transform-box: fill-box; transform-origin: center; animation: shine 5s ease-in-out infinite; }
  .shine.small { animation-delay: 1.2s; }
  @keyframes twinkle { 50% { opacity: 0.1; } }
  @keyframes glint { 50% { opacity: 0.8; } }
  @keyframes breathe { 50% { transform: scale(1.15); opacity: 0.8; } }
  @keyframes shine { 50% { transform: scale(0.88); opacity: 0.85; } }
  @media (prefers-reduced-motion: reduce) {
    .tw, .dipper, .breathe, .shine { animation: none; }
  }
</style>
