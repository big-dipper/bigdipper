---
/**
 * The home page's night sky, full width behind the opening words. The Big Dipper's pointer stars (Merak, then
 * Dubhe) lead to Polaris, the tip of the Little Dipper's handle: Big Dipper points you to your Little Dipper, and
 * your Little Dipper holds your North Star. Drawn, not photographed; the background stars come from a fixed seed,
 * so the sky is the same on every visit.
 */
type P = [number, number];
const big = {
  alkaid: [820, 575] as P, mizar: [902, 512] as P, alioth: [978, 482] as P, megrez: [1052, 466] as P,
  phecda: [1046, 574] as P, merak: [1150, 604] as P, dubhe: [1172, 478] as P,
};
// Polaris sits on the line from Merak through Dubhe, as it does in the real sky.
const k = 2.55;
const polaris: P = [big.dubhe[0] + k * (big.dubhe[0] - big.merak[0]), big.dubhe[1] + k * (big.dubhe[1] - big.merak[1])];
const little: P[] = [polaris, [1296, 184], [1352, 214], [1394, 262], [1474, 236], [1500, 304], [1418, 326], [1394, 262]];
const bigLines: P[] = [big.alkaid, big.mizar, big.alioth, big.megrez, big.dubhe, big.merak, big.phecda, big.megrez];
const path = (pts: P[]) => pts.map(([x, y], i) => `${i ? 'L' : 'M'}${x.toFixed(1)} ${y.toFixed(1)}`).join(' ');

let seed = 11;
const rand = () => ((seed = (seed * 16807) % 2147483647) / 2147483647);
const tints = ['#ffffff', '#ffffff', '#ffffff', '#dfe8ff', '#fff1d6', '#cfe0f5'];
const dust = Array.from({ length: 340 }, () => {
  const bright = rand() > 0.93;
  return { x: rand() * 1600, y: rand() * 720, r: bright ? 1.3 + rand() * 1.1 : 0.35 + rand() * 0.8, o: 0.25 + rand() * 0.6, c: tints[Math.floor(rand() * tints.length)], d: (rand() * 7).toFixed(1), tw: rand() > 0.6 };
});
const [px, py] = polaris;
---
<svg class="sky" viewBox="0 0 1600 720" preserveAspectRatio="xMidYMid slice" role="img"
  aria-label="A night sky. The Big Dipper's two pointer stars lead to Polaris, the North Star, at the tip of the Little Dipper's handle.">
  <defs>
    <radialGradient id="polaris-glow"><stop offset="0" stop-color="#fff4dc" stop-opacity="0.95" /><stop offset="0.25" stop-color="#ffe2a8" stop-opacity="0.45" /><stop offset="1" stop-color="#ffd27a" stop-opacity="0" /></radialGradient>
    <radialGradient id="star-glow"><stop offset="0" stop-color="#ffffff" stop-opacity="0.7" /><stop offset="1" stop-color="#ffffff" stop-opacity="0" /></radialGradient>
    <radialGradient id="haze"><stop offset="0" stop-color="#8fa8d8" stop-opacity="0.16" /><stop offset="1" stop-color="#8fa8d8" stop-opacity="0" /></radialGradient>
    <linearGradient id="spike-h" x1="0" x2="1"><stop offset="0" stop-color="#fff4dc" stop-opacity="0" /><stop offset="0.5" stop-color="#fff4dc" stop-opacity="0.9" /><stop offset="1" stop-color="#fff4dc" stop-opacity="0" /></linearGradient>
    <linearGradient id="spike-v" x1="0" x2="0" y1="0" y2="1"><stop offset="0" stop-color="#fff4dc" stop-opacity="0" /><stop offset="0.5" stop-color="#fff4dc" stop-opacity="0.9" /><stop offset="1" stop-color="#fff4dc" stop-opacity="0" /></linearGradient>
    <linearGradient id="fade-left" x1="0" x2="1"><stop offset="0" stop-color="#0d1119" stop-opacity="0.75" /><stop offset="0.45" stop-color="#0d1119" stop-opacity="0.15" /><stop offset="1" stop-color="#0d1119" stop-opacity="0" /></linearGradient>
  </defs>

  <!-- A faint band of the Milky Way across the sky -->
  <g transform="rotate(-24 800 360)">
    <ellipse cx="760" cy="360" rx="900" ry="120" fill="url(#haze)" />
    <ellipse cx="980" cy="330" rx="520" ry="70" fill="url(#haze)" />
  </g>

  <g>{dust.map((s) => <circle cx={s.x} cy={s.y} r={s.r} fill={s.c} opacity={s.o} class={s.tw ? 'tw' : undefined} style={s.tw ? `animation-delay:${s.d}s` : undefined} />)}</g>

  <!-- Readability: the words sit on the darker left -->
  <rect width="1600" height="720" fill="url(#fade-left)" />

  <path class="figure big" d={path(bigLines)} />
  <path class="figure little" d={path(little)} />
  <path class="pointer" d={path([big.merak, polaris])} />

  {Object.values(big).map(([x, y]) => <><circle cx={x} cy={y} r="11" fill="url(#star-glow)" /><circle class="star" cx={x} cy={y} r="4.2" /></>)}
  {little.slice(1, 7).map(([x, y]) => <><circle cx={x} cy={y} r="9" fill="url(#star-glow)" /><circle class="star warm" cx={x} cy={y} r="3.6" /></>)}

  <g>
    <circle cx={px} cy={py} r="70" fill="url(#polaris-glow)" class="breathe" />
    <rect x={px - 60} y={py - 1.2} width="120" height="2.4" fill="url(#spike-h)" />
    <rect x={px - 1.2} y={py - 60} width="2.4" height="120" fill="url(#spike-v)" />
    <rect x={px - 26} y={py - 0.8} width="52" height="1.6" fill="url(#spike-h)" transform={`rotate(45 ${px} ${py})`} opacity="0.6" />
    <rect x={px - 26} y={py - 0.8} width="52" height="1.6" fill="url(#spike-h)" transform={`rotate(-45 ${px} ${py})`} opacity="0.6" />
    <circle cx={px} cy={py} r="7.5" fill="#fffaf0" />
  </g>

  <text x={px + 22} y={py - 20} class="label gold">Polaris · the North Star</text>
  <text x="1430" y="360" class="label">Little Dipper</text>
  <text x="930" y="630" class="label">Big Dipper</text>
</svg>

<style>
  .sky { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .tw { animation: twinkle 7s ease-in-out infinite; }
  .figure { fill: none; stroke-width: 1.8; stroke-linejoin: round; stroke-linecap: round; }
  .figure.big { stroke: #a9c2e6; stroke-opacity: 0.6; }
  .figure.little { stroke: #ffe2a8; stroke-opacity: 0.7; }
  .pointer { fill: none; stroke: #ffe7b8; stroke-opacity: 0.85; stroke-width: 1.6; stroke-dasharray: 2 9; stroke-linecap: round; opacity: 0; animation: appear 2s ease-out 0.4s forwards; }
  .star { fill: #f4f6ff; }
  .star.warm { fill: #fff4dc; }
  .breathe { animation: breathe 5s ease-in-out infinite; transform-box: fill-box; transform-origin: center; }
  .label { fill: #c9d6ea; font-size: 15px; letter-spacing: 0.14em; text-transform: uppercase; font-family: var(--font-body); opacity: 0.75; }
  .label.gold { fill: #ffe7b8; opacity: 0.95; }
  @keyframes twinkle { 50% { opacity: 0.12; } }
  @keyframes appear { to { opacity: 1; } }
  @keyframes breathe { 50% { transform: scale(1.18); opacity: 0.8; } }
  @media (prefers-reduced-motion: reduce) {
    .tw, .breathe { animation: none; }
    .pointer { animation: none; opacity: 1; }
  }
</style>
