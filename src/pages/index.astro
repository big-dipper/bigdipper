---
import Base from '../layouts/Base.astro';
import Sky from '../components/Sky.astro';
import DomainIcon from '../components/DomainIcon.astro';
import { DEMO_URL, RAILWAY_MONTHLY } from '../lib/config';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// What a Little Dipper holds, grouped the way a person thinks of it. Matches the record types in Little Dipper's catalog.
// tone: which soft color the tile takes, so the grid reads at a glance.
const cats: { icon: string; title: string; tone: string; items: string[] }[] = [
  { icon: 'identity', title: 'Who you are', tone: 'navy', items: ['Names', 'Birth', 'IDs & passports', 'Citizenship'] },
  { icon: 'journey', title: 'Where you’ve been', tone: 'teal', items: ['Addresses', 'Jobs', 'Schools', 'Travel'] },
  { icon: 'health', title: 'Your health', tone: 'rose', items: ['Conditions', 'Medications', 'Allergies', 'Immunizations', 'Lab results'] },
  { icon: 'money', title: 'Your money', tone: 'ochre', items: ['Accounts', 'Income', 'Transactions', 'Tax returns', 'Receipts'] },
  { icon: 'belongings', title: 'What you own', tone: 'clay', items: ['Homes', 'Vehicles', 'Valuables', 'Insurance'] },
  { icon: 'people', title: 'People & pets', tone: 'plum', items: ['Family', 'Friends', 'Pets', 'Memberships'] },
  { icon: 'documents', title: 'Documents', tone: 'sage', items: ['Scans', 'Certificates', 'Contracts', 'Legal papers'] },
  { icon: 'dates', title: 'Dates', tone: 'sky', items: ['Birthdays', 'Renewals', 'Expiry dates', 'Events'] },
];

/** Things people actually say to an assistant. Only what works today with an assistant like Claude or Muse. */
const ASKS: [string, string][] = [
  ['“Here’s a photo of my birth certificate. Add what it says.”', 'It reads the photo and suggests the entries. Nothing is saved until you OK it.'],
  ['“What’s coming up this month that I need to deal with?”', 'Renewals, expiring IDs, birthdays and bills, gathered from everything you’ve kept.'],
  ['“Where’s my car title, and when does my registration run out?”', 'Finds the document and the date in seconds.'],
  ['“Go through my email and add my receipts from this year.”', 'Files each one, with where it came from, ready for returns, warranties and taxes.'],
  ['“Help me fill in this rental application.”', 'Pulls your past addresses, jobs and references, for you to check.'],
  ['“I have debts in collections. Help me make a plan.”', 'Lays out who you owe and what, and helps you decide what to tackle first.'],
  ['“Write my résumé from my work history.”', 'Uses the jobs, schools and dates you’ve already recorded.'],
  ['“What does my accountant need from me for taxes?”', 'Gathers your income, receipts and statements so you can send them.'],
];
---
<Base night title="Little Dipper: life management for the AI era" description="Little Dipper is a private home for all of your life’s data, on a server that belongs to you. Free, open-source software; you pay the host, usually about $5 a month.">
  <div class="night-hero">
    <Sky />
    <div class="wrap hero-grid">
      <div>
        <div class="kicker">Friends and family beta</div>
        <div class="wordmark">Little Dipper</div>
        <h1>Life management for the AI&nbsp;era.</h1>
        <p class="lede">A private home for all of your life’s data, on a server that belongs to you.</p>
        <div class="actions">
          <a class="btn btn-primary btn-lg" href={`${base}/get-started`}>Get your Little Dipper</a>
          <a class="btn btn-ghost btn-lg" href={DEMO_URL}>Try the demo</a>
        </div>
      </div>
    </div>
  </div>
  <div class="dawn" aria-hidden="true"></div>

  <section class="wrap" id="what">
    <div class="kicker">Everything about your life, in one place</div>
    <h2>The things you’re always looking for</h2>
    <p class="note" style="margin-top: -4px">Every address for the last five years? Your passport number? Last year’s tax return? A minute, not an afternoon.</p>
    <div class="cats">
      {cats.map((c) => (
        <div class={`cat tone-${c.tone}`}>
          <span class="cat-icon"><DomainIcon name={c.icon} size={34} /></span>
          <h3>{c.title}</h3>
          <ul class="chips">{c.items.map((i) => <li>{i}</li>)}</ul>
        </div>
      ))}
    </div>
  </section>

  <section class="wrap" id="deal">
    <div class="kicker kicker-lg">A different kind of deal</div>
    <h2>Free software. Your choice of home.</h2>
    <p class="lede" style="font-size: 18px">Little Dipper is free and open source. It runs on a server that’s yours, in the cloud or on a computer at home, and answers only to you. No ads, and no one in the middle.</p>
    <div class="homes">
      <div class="home-card featured">
        <div class="home-head">
          <span class="home-icon"><DomainIcon name="cloud" size={34} /></span>
          <div><h3>In the cloud</h3><span class="badge">Easiest · no technical skills</span></div>
        </div>
        <p class="price"><strong>{RAILWAY_MONTHLY[0].toUpperCase() + RAILWAY_MONTHLY.slice(1)} a month</strong>, paid straight to the hosting company. Nothing to us.</p>
        <ol class="mini-steps">
          <li>Press one button</li>
          <li>Make an account with the host</li>
          <li>Claim it with your passkey</li>
        </ol>
        <p class="small">About ten minutes, and we walk you through every screen.</p>
        <a class="btn btn-lg cloud-cta" href={`${base}/get-started`}>Get your Little Dipper</a>
      </div>
      <div class="move" aria-hidden="true"><span>⇄</span></div>
      <div class="home-card">
        <div class="home-head">
          <span class="home-icon"><DomainIcon name="computer" size={34} /></span>
          <div><h3>On your own computer</h3><span class="badge quiet">For the technically comfortable</span></div>
        </div>
        <p class="price"><strong>Free to run</strong> on hardware you already own: a spare computer, a Mac mini, a home server.</p>
        <p class="small">Today this route uses Docker, so it takes some technical know-how. <a href="https://github.com/big-dipper/littledipper#readme">How to run it at home</a></p>
      </div>
    </div>
    <p class="move-note"><strong>Move between them whenever you like.</strong> Your recovery kit packs everything up, and your Little Dipper picks up where it left off.</p>
  </section>

  <section class="wrap" id="ai">
    <div class="ai-band">
      <div>
        <div class="kicker">Your AI, acting for you</div>
        <h2>Let your AI act on your behalf</h2>
        <p class="lede" style="font-size: 18px">Invite Claude, Muse or another assistant and put it to work: filing receipts, logging a new job, adding the people you meet, keeping your dates current.</p>
        <p class="soon">Next: acting for you out in the world, with companies and services, under the same limits and the same log.</p>
      </div>
      <div class="ai-controls">
        <h3>You stay in charge</h3>
        <ul class="limits">
          <li><strong>You choose what it sees,</strong> category by category. ID numbers and other secrets stay hidden unless you say otherwise.</li>
          <li><strong>You choose what it does:</strong> just answer questions, suggest changes for your OK, or make them itself.</li>
          <li><strong>Some things stay yours alone.</strong> Changes to who you are always wait for you, and it can never export your data or give anyone else access.</li>
          <li><strong>Every action is logged</strong> and can be undone. Change its access or disconnect it, and that applies from its very next request.</li>
        </ul>
      </div>
    </div>

    <div class="asks">
      <h3>Not sure what to ask? Try these.</h3>
      <p class="asks-sub">Say them to your assistant once it's connected to your Little Dipper.</p>
      <div class="asks-grid">
        {ASKS.map(([say, does]) => (
          <figure class="ask">
            <blockquote>{say}</blockquote>
            <figcaption>{does}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="wrap">
    <div class="share-band">
      <div class="share-intro">
        <div class="kicker">Sharing</div>
        <h2>Share with total control</h2>
        <p>Connect with other Little Dippers, or send anyone a link.</p>
        <ul class="share-points">
          <li><strong>Exactly what you choose,</strong> and nothing else</li>
          <li><strong>See who looked</strong> and when</li>
          <li><strong>Take it back</strong> whenever you like</li>
        </ul>
      </div>
      <div class="screens">
        <figure class="screen">
          <div class="screen-bar" aria-hidden="true"><i></i><i></i><i></i></div>
          <img src={`${base}/screens/share-ask.png`} width="900" height="340" loading="lazy" alt="Theo asks to connect and also asks for your home address. That's a box you can leave unticked, and you can change what Theo sees any time." />
          <figcaption><strong>They ask, you decide.</strong> Theo asks for your home address too. Leave it unticked and Theo won’t get it.</figcaption>
        </figure>
        <figure class="screen">
          <div class="screen-bar" aria-hidden="true"><i></i><i></i><i></i></div>
          <img src={`${base}/screens/share-categories.png`} width="890" height="380" loading="lazy" alt="Each category of your life with Off, Current and All: share only your current address, or every address you've had, or nothing." />
          <figcaption><strong>Category by category.</strong> Off, just what’s current, or all of it. Changes apply right away.</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="wrap" id="big-dipper">
    <div class="band">
      <div class="kicker">Big Dipper, your safety net</div>
      <h2>Your own server, but never on your own</h2>
      <p class="lede" style="font-size: 18px">Running your own server is a fair thing to worry about. Little Dipper is built to keep running even if Big Dipper went away, and Big Dipper is here to look out for it in the meantime. Here’s the plan.</p>
      <div class="plan">
        <div>
          <div class="when">Today</div>
          <ul>
            <li>Backups saved to your own computer</li>
            <li>A recovery kit that moves you to any server</li>
            <li>Open-source code anyone can run, so your Little Dipper outlives any company, including us</li>
            <li>Feedback from inside your Little Dipper: connect to Big Dipper and tell us what’s wrong or what you’d like, with a picture of your screen that’s blurred unless you say otherwise</li>
          </ul>
        </div>
        <div>
          <div class="when">Next, with Big Dipper</div>
          <ul>
            <li>Health checks that warn you before something breaks</li>
            <li>One-click upgrades</li>
            <li>Answers and help from inside your Little Dipper</li>
          </ul>
        </div>
        <div>
          <div class="when">Later</div>
          <ul>
            <li>Third-party verification: prove who you are, or that you’re over 21, without handing over your documents</li>
            <li>A way for businesses to connect to your Little Dipper, on your terms</li>
          </ul>
        </div>
      </div>
      <p class="note" style="margin-top: 18px">Connecting to Big Dipper is optional, and it never holds your data or your keys.</p>
    </div>
  </section>

  <section class="wrap" id="how">
    <div class="kicker">How it works</div>
    <h2>From nothing to your own Little Dipper</h2>
    <ol class="steps" style="margin-top: 20px; max-width: 760px">
      <li><div><h3>Start one with a button</h3><p>Little Dipper sets itself up with Railway, a hosting company. You pay them directly, {RAILWAY_MONTHLY} a month. Big Dipper doesn’t charge you anything. Prefer another cloud provider, or a computer at home? Little Dipper runs there too.</p></div></li>
      <li><div><h3>Make it yours with a passkey</h3><p>Sign in with your face, fingerprint, device PIN or a security key. No password to forget.</p></div></li>
      <li><div><h3>Fill it as you go</h3><p>Add things yourself, or invite your AI assistant to help. Nothing has to be done all at once.</p></div></li>
      <li><div><h3>Keep a copy at home</h3><p>Little Dipper reminds you to save backups to your own computer, and your recovery kit lets you move it to a new server at any time.</p></div></li>
    </ol>
  </section>

  <section class="wrap">
    <div class="kicker">Honest about limits</div>
    <h2>What to know before you start</h2>
    <ul class="honest" style="max-width: 760px">
      <li><strong>This is a beta</strong> for friends and family. Expect rough edges, and tell us about them: connect your Little Dipper to Big Dipper and a feedback button appears inside it.</li>
      <li><strong>Your server, your responsibility.</strong> Keep your recovery codes and recovery kit somewhere safe. Nobody, including us, can unlock your Little Dipper without them.</li>
      <li><strong>The hosting company runs the hardware.</strong> Your data is encrypted where it matters most, but whoever runs a server can physically reach it. You can move to another host or a device at home whenever you like.</li>
      <li><strong>What your AI assistant reads goes to the company that runs it.</strong> That’s why you decide exactly what it can see and do, and you can narrow that or disconnect it at any moment. Soon you’ll also be able to use an open-weight model you run yourself, so nothing leaves your hands.</li>
      <li><strong>Big Dipper never sees your data.</strong> It has no accounts and no database. It points you to the tools and gets out of the way. If you connect and send feedback, it gets only what you send, shown to you first, and files it in Linear, the tool we track our work in.</li>
    </ul>
    <div class="actions"><a class="btn btn-primary btn-lg" href={`${base}/get-started`}>Get your Little Dipper</a></div>
  </section>
</Base>
