---
import Base from '../../layouts/Base.astro';
import Level from '../../components/Level.astro';
import RunAnywhere from '../../components/RunAnywhere.astro';
import { RAILWAY_MONTHLY } from '../../lib/config';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const others: [string, string, string][] = [
  ['Amazon Web Services (AWS)', 'About $5–10 a month', 'A small Lightsail or EC2 server with a disk.'],
  ['Google Cloud', 'About $7–15 a month', 'A small Compute Engine virtual machine with a disk.'],
  ['Microsoft Azure', 'About $8–15 a month', 'A small virtual machine with a disk.'],
  ['DigitalOcean', 'About $4–6 a month', 'A small server (a Droplet) you look after yourself.'],
  ['Fly.io', 'About $4–5 a month', 'A small machine plus a small disk.'],
  ['Render', 'About $7–8 a month', 'A starter service plus a small disk.'],
  ['Hetzner', 'About $4–6 a month', 'A small cloud server you look after yourself.'],
  ['Akamai (Linode)', 'About $5–7 a month', 'A small server you look after yourself.'],
];
---
<Base title="Your own cloud account · Little Dipper" description="Run your Little Dipper in your own account with a hosting company. Guided on Railway, about ten minutes and about $5 a month.">
  <div class="narrow hero" style="padding-bottom: 6px">
    <div class="kicker">Your own cloud account</div>
    <h1 style="font-size: clamp(36px, 5vw, 52px)">Your Little Dipper, in your own hosting account.</h1>
    <p class="lede">You sign up with a hosting company and your Little Dipper runs in your account, on your card. We walk you through it on Railway, screen by screen.</p>
    <p style="margin-top: 18px"><Level of={2} label="Guided: comfortable signing up for things online" /></p>
  </div>

  <div class="narrow">
    <section>
      <h2>Why people choose this</h2>
      <ul class="prose">
        <li><strong>The account is yours.</strong> The server lives in your hosting account, and you pay the hosting company directly. We’re not in the middle.</li>
        <li><strong>A little cheaper.</strong> About {RAILWAY_MONTHLY} a month on Railway, depending on how much you store.</li>
        <li><strong>Still easy.</strong> No servers to set up by hand. Railway installs small updates on its own; bigger ones take one click.</li>
      </ul>
    </section>

    <section>
      <h2>What it takes</h2>
      <ul class="prose">
        <li>An email address and a card for Railway.</li>
        <li>About ten minutes, following our guide.</li>
        <li>A phone or computer that can use a passkey (your face, fingerprint, device PIN or a security key).</li>
        <li>Keeping an eye on your Railway account: if a payment there fails, Railway can stop your server. Keep a backup on your own computer and you can always bring it back.</li>
      </ul>
    </section>

    <section class="band" style="margin-top: 28px">
      <h2 style="margin-top: 0">Railway, guided</h2>
      <p>Four steps: make a Railway account, start your Little Dipper with one button, wait for it to start, then claim it with your passkey.</p>
      <div class="actions"><a class="btn btn-primary btn-lg" href={`${base}/get-started`}>Start the Railway guide</a></div>
    </section>

    <section>
      <h2>Other hosting companies</h2>
      <p>Little Dipper runs on any cloud that runs Docker, including all the big names. <strong>If you’re comfortable with servers, you can use any of these today:</strong> the <a href="https://github.com/big-dipper/littledipper#readme">Little Dipper README</a> covers what you need. <strong>Step-by-step guides for everyone else are coming.</strong></p>
      <div style="overflow-x: auto">
        <table class="compare">
          <thead><tr><th>Company</th><th>Rough cost</th><th>What you’d set up</th><th>Today</th></tr></thead>
          <tbody>
            {others.map(([name, cost, what]) => <tr><th>{name}</th><td>{cost}</td><td>{what}</td><td>Works now, if you know servers. Guide coming.</td></tr>)}
          </tbody>
        </table>
      </div>
      <p class="note" style="margin-top: 10px">Costs are rough estimates for one small Little Dipper, paid to the company each month. Some offer free tiers or credits for new accounts. Check their current prices before you start.</p>
      <RunAnywhere />
    </section>
  </div>
</Base>
